{
  "name": "gazelle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "prepare": "husky",
    "discover": "tsx --env-file=.env.local scripts/discover.ts",
    "setup:e2e-user": "tsx --env-file=.env.local scripts/setup-e2e-user.ts",
    "verify:e2e-isolation": "tsx --env-file=.env.local scripts/verify-e2e-isolation.ts",
    "needs-human": "tsx --env-file=.env.local scripts/needs-human.ts",
    "migrate": "bash -c 'set -a && source .env.local && set +a && supabase db push --linked'",
    "migrate:status": "bash -c 'set -a && source .env.local && set +a && supabase migration list --linked'"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": "eslint --fix --no-warn-ignored"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
